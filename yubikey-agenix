#!/usr/bin/env bash

set -Eeuo pipefail
umask 0077

resolve_script_path() {
  local source="${BASH_SOURCE[0]}" directory target
  if [[ "${source}" != */* ]]; then
    source="$(command -v -- "${source}")"
  fi
  while [[ -L "${source}" ]]; do
    directory="$(cd -P -- "$(dirname -- "${source}")" && pwd)"
    target="$(readlink "${source}")"
    if [[ "${target}" == /* ]]; then
      source="${target}"
    else
      source="${directory}/${target}"
    fi
  done
  directory="$(cd -P -- "$(dirname -- "${source}")" && pwd)"
  printf '%s/%s\n' "${directory}" "$(basename -- "${source}")"
}

SCRIPT_PATH="$(resolve_script_path)"
readonly SCRIPT_PATH
REPO_ROOT="$(dirname -- "${SCRIPT_PATH}")"
readonly REPO_ROOT
readonly SETUP_PATH="${REPO_ROOT}/setup"
readonly AGE_CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/age"
readonly IDENTITY_FILE="${AGE_YUBIKEY_IDENTITY_PATH:-${AGE_CONFIG_DIR}/yubikey-identities.txt}"
readonly RECIPIENTS_FILE="${AGE_YUBIKEY_RECIPIENTS_PATH:-${AGE_CONFIG_DIR}/yubikey-recipients.txt}"

info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mwarning:\033[0m %s\n' "$*" >&2; }
fail() { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<EOF
Usage: $(basename "${SCRIPT_PATH}") [--enroll|--enroll-only|--repair-management-key|--status|--test|--help]

Provision or import a hardware-backed Age identity on the connected YubiKey.
Run once for each card. Existing occupied PIV slots are never overwritten.

  --enroll       Enrol/import the card, test it, and offer to update secrets
                 (default)
  --enroll-only  Enrol/import and test without updating the secrets repository
  --repair-management-key
                 Convert an incompatible PIV management key to a random,
                 PIN-protected TDES key without erasing PIV slots
  --status       Show saved recipients and identities on connected cards
  --test         Test Age encryption/decryption with the connected card
  --help         Show this help

The private key is generated inside a retired PIV slot and cannot be exported.
The local identity file contains only the public card locator needed by Age.
EOF
}

confirm() {
  local answer
  [[ -t 0 ]] || fail "An interactive terminal is required."
  IFS= read -r -p "$1 [y/N] " answer
  case "${answer}" in
    y|Y|yes|YES|Yes) return 0 ;;
    *) return 1 ;;
  esac
}

require_normal_user() {
  [[ "$(id -u)" -ne 0 ]] || fail "Run this as your normal user, not with sudo."
}

ensure_dependencies() {
  if command -v age >/dev/null 2>&1 && command -v age-plugin-yubikey >/dev/null 2>&1; then
    return 0
  fi

  if [[ -z "${YUBIKEY_AGENIX_NIX_SHELL:-}" ]] && command -v nix >/dev/null 2>&1; then
    info "Loading Age and its YubiKey plugin from Nix"
    exec nix --extra-experimental-features 'nix-command flakes' shell \
      nixpkgs#age nixpkgs#age-plugin-yubikey \
      --command env YUBIKEY_AGENIX_NIX_SHELL=1 "${SCRIPT_PATH}" "$@"
  fi

  fail "age and age-plugin-yubikey are required. Install this dotfiles configuration, or install both packages with Nix/Homebrew before retrying."
}

run_plugin() {
  # C.UTF-8 is valid to libc but is rejected by the plugin's language parser.
  LC_ALL="${AGE_YUBIKEY_LOCALE:-en_US.UTF-8}" \
    LANGUAGE="${AGE_YUBIKEY_LANGUAGE:-en-US}" \
    age-plugin-yubikey "$@"
}

run_age() {
  LC_ALL="${AGE_YUBIKEY_LOCALE:-en_US.UTF-8}" \
    LANGUAGE="${AGE_YUBIKEY_LANGUAGE:-en-US}" \
    age "$@"
}

run_ykman() {
  if command -v ykman >/dev/null 2>&1; then
    ykman "$@"
  elif command -v nix >/dev/null 2>&1; then
    nix --extra-experimental-features 'nix-command flakes' shell \
      nixpkgs#yubikey-manager --command ykman "$@"
  else
    fail "YubiKey Manager CLI (ykman) is required for this repair. Install yubikey-manager and retry."
  fi
}

linux_pcscd_active() {
  if command -v systemctl >/dev/null 2>&1; then
    systemctl is-active --quiet pcscd.socket 2>/dev/null || \
      systemctl is-active --quiet pcscd.service 2>/dev/null
  else
    pgrep -x pcscd >/dev/null 2>&1
  fi
}

start_linux_pcscd() {
  [[ "$(uname -s)" == "Linux" ]] || return 0
  linux_pcscd_active && return 0

  if [[ -e /etc/NIXOS ]]; then
    fail "The PC/SC service is not active. This repository now enables it on NixOS; run ./setup switch, then retry."
  fi

  confirm "Install and start the PC/SC smart-card service?" || fail "PC/SC is required to access the YubiKey."
  if command -v apt-get >/dev/null 2>&1; then
    sudo apt-get update
    sudo apt-get install -y pcscd libccid
  elif command -v dnf >/dev/null 2>&1; then
    sudo dnf install -y pcsc-lite ccid
  elif command -v pacman >/dev/null 2>&1; then
    sudo pacman -S --needed pcsclite ccid
  else
    fail "Install and start pcscd with this distribution's package manager, then retry."
  fi

  if command -v systemctl >/dev/null 2>&1; then
    sudo systemctl enable --now pcscd.socket 2>/dev/null || \
      sudo systemctl enable --now pcscd.service
  elif command -v service >/dev/null 2>&1; then
    sudo service pcscd start
  fi
  linux_pcscd_active || fail "pcscd was installed but is not active. Start it and retry."
}

release_gpg_smartcard() {
  # GnuPG's internal CCID driver can hold an exclusive reader lock. It will
  # start scdaemon again automatically the next time OpenPGP is used.
  if command -v gpgconf >/dev/null 2>&1; then
    gpgconf --kill scdaemon >/dev/null 2>&1 || true
  fi
}

repair_management_key() {
  local piv_info management_algorithm
  start_linux_pcscd
  release_gpg_smartcard

  info "Current PIV status (this does not verify or consume a PIN attempt)"
  piv_info="$(run_ykman piv info)"
  printf '%s\n' "${piv_info}"

  if printf '%s\n' "${piv_info}" | grep -Eiq '(protected by PIN|PIN-protected)'; then
    info "The management key is already PIN-protected; no repair is needed"
    return 0
  fi

  management_algorithm="$(printf '%s\n' "${piv_info}" |
    sed -nE 's/^[[:space:]]*Management key algorithm:[[:space:]]*([^[:space:]]+).*$/\1/p' |
    head -n 1)"
  printf '\nThis changes only the PIV management key used for administrative writes.\n'
  printf 'It does not change the PIV PIN and does not erase certificates or private keys, including slot 9a.\n'
  if printf '%s\n' "${piv_info}" | grep -Eiq 'WARNING: Using default Management key'; then
    printf 'The current management key is the factory default, so leave the current-key prompt blank.\n'
  else
    warn "This card uses a custom, unprotected ${management_algorithm:-PIV} management key."
    printf 'You must enter the current saved management key; leaving the prompt blank will fail.\n'
    if [[ "${management_algorithm}" == "TDES" ]]; then
      printf 'A TDES management key is 48 hexadecimal characters. It is not the PIV PIN, PUK, OpenPGP PIN, or FIDO2 PIN.\n'
    fi
    confirm "Do you have the current management key?" || \
      fail "The key cannot be recovered from the card. No changes were made. Do not reset PIV while slot 9a is needed for computer login."
  fi
  confirm "Convert it to a random PIN-protected TDES management key?" || fail "Cancelled without changing the card."

  if ! run_ykman piv access change-management-key --algorithm TDES --protect; then
    fail "Management-key authentication failed. The card was not changed. Retry only after locating the current management key; a PIV reset would erase slot 9a."
  fi
  info "The PIV management key is now compatible with age-plugin-yubikey"
  info "Run ./setup yubikey-agenix again to provision the Age identity"
}

preflight_management_key() {
  local piv_info
  if ! piv_info="$(run_ykman piv info 2>/dev/null)"; then
    return 0
  fi

  if ! printf '%s\n' "${piv_info}" | grep -Eiq '(protected by PIN|PIN-protected|WARNING: Using default Management key)'; then
    printf '%s\n' "${piv_info}"
    fail "This card has a custom, unprotected PIV management key, which age-plugin-yubikey cannot use. Locate the saved current management key, then run ./setup yubikey-agenix --repair-management-key. Leaving its prompt blank will fail."
  fi
}

extract_identities() {
  awk '/^AGE-PLUGIN-YUBIKEY-[A-Z0-9]+$/ && !seen[$0]++ { print }' "$1"
}

extract_recipients() {
  awk '$1 == "#" && $2 == "Recipient:" && $3 ~ /^age1yubikey1[0-9a-z]+$/ && !seen[$3]++ { print $3 }' "$1"
}

count_lines() {
  awk 'NF { count++ } END { print count + 0 }' "$1"
}

merge_public_material() (
  local plugin_output="$1" new_identities new_recipients merged
  new_identities="$(mktemp)"
  new_recipients="$(mktemp)"
  merged="$(mktemp)"
  trap 'rm -f "${new_identities:-}" "${new_recipients:-}" "${merged:-}"' EXIT

  extract_identities "${plugin_output}" > "${new_identities}"
  extract_recipients "${plugin_output}" > "${new_recipients}"
  [[ -s "${new_identities}" && -s "${new_recipients}" ]] || \
    fail "The plugin did not return a valid YubiKey identity and recipient."

  install -d -m 700 "${AGE_CONFIG_DIR}"
  {
    [[ -r "${IDENTITY_FILE}" ]] && cat "${IDENTITY_FILE}"
    cat "${new_identities}"
  } | awk '/^AGE-PLUGIN-YUBIKEY-[A-Z0-9]+$/ && !seen[$0]++ { print }' > "${merged}"
  install -m 600 "${merged}" "${IDENTITY_FILE}"

  {
    [[ -r "${RECIPIENTS_FILE}" ]] && cat "${RECIPIENTS_FILE}"
    cat "${new_recipients}"
  } | awk '/^age1yubikey1[0-9a-z]+$/ && !seen[$0]++ { print }' > "${merged}"
  install -m 600 "${merged}" "${RECIPIENTS_FILE}"

)

test_material() (
  local plugin_output="$1" workspace identities recipients plaintext encrypted decrypted
  workspace="$(mktemp -d "${TMPDIR:-/tmp}/yubikey-agenix-test.XXXXXX")"
  trap 'rm -rf -- "${workspace:-}"' EXIT
  identities="${workspace}/identities.txt"
  recipients="${workspace}/recipients.txt"
  plaintext="${workspace}/plain"
  encrypted="${workspace}/plain.age"
  decrypted="${workspace}/decrypted"

  extract_identities "${plugin_output}" > "${identities}"
  extract_recipients "${plugin_output}" > "${recipients}"
  [[ -s "${identities}" && -s "${recipients}" ]] || fail "No testable Age identity was reported by the connected YubiKey."
  printf 'dotfiles Agenix YubiKey test\n' > "${plaintext}"

  info "Testing hardware encryption; enter the PIV PIN and touch the YubiKey when requested"
  run_age --encrypt --recipients-file "${recipients}" --output "${encrypted}" "${plaintext}"
  run_age --decrypt --identity "${identities}" --output "${decrypted}" "${encrypted}"
  cmp -s "${plaintext}" "${decrypted}" || fail "The YubiKey decrypted different data than was encrypted."
  info "Hardware-backed Age encryption and decryption succeeded"

)

connected_identity_output() {
  local output_file="$1"
  if ! run_plugin --identity > "${output_file}"; then
    fail "Could not read Age identities from the connected YubiKey."
  fi
}

enroll() (
  local update_after="$1" output identities recipients name
  output="$(mktemp)"
  identities="$(mktemp)"
  recipients="$(mktemp)"
  trap 'rm -f "${output:-}" "${identities:-}" "${recipients:-}"' EXIT

  start_linux_pcscd
  release_gpg_smartcard
  connected_identity_output "${output}"
  extract_identities "${output}" > "${identities}"

  if [[ ! -s "${identities}" ]]; then
    preflight_management_key
    printf 'No existing age-plugin-yubikey identity was found on the connected card.\n'
    printf 'A new non-exportable P-256 key will be generated in the first empty retired PIV slot.\n'
    printf 'If the PIV PIN or management key is still at its factory default, the plugin will securely change it after prompting you.\n'
    confirm "Provision this YubiKey for Agenix?" || fail "Cancelled without changing the card."
    name="${AGE_YUBIKEY_NAME:-Agenix $(hostname -s 2>/dev/null || hostname)}"
    run_plugin --generate \
      --name "${name}" \
      --pin-policy once \
      --touch-policy always > "${output}"
    extract_identities "${output}" > "${identities}"
  else
    info "Importing the existing hardware-backed Age identity from this YubiKey"
  fi

  extract_recipients "${output}" > "${recipients}"
  [[ -s "${identities}" && -s "${recipients}" ]] || fail "The connected card did not return complete Age identity information."
  merge_public_material "${output}"
  info "Saved $(count_lines "${identities}") card identity locator(s) to ${IDENTITY_FILE}"
  info "Saved public recipients to ${RECIPIENTS_FILE}"
  test_material "${output}"

  [[ "${update_after}" == "yes" ]] || return 0
  offer_secrets_update
)

offer_secrets_update() {
  local config_source="${HOME}/.ssh/config_external"
  [[ -r "${config_source}" ]] || config_source="${REPO_ROOT}/nix-darwin/modules/shared/config/ssh/config_external"
  [[ -x "${SETUP_PATH}" ]] || {
    warn "Run setup update-secrets to add all enrolled YubiKeys to the Agenix recipients."
    return 0
  }

  if [[ -r "${HOME}/.ssh/id_rsa" && -r "${HOME}/.ssh/authorized_keys" && -r "${config_source}" ]]; then
    if confirm "Re-encrypt and push the secrets for every enrolled YubiKey now?"; then
      exec "${SETUP_PATH}" update-secrets
    fi
    info "Enrollment is complete. Run ./setup update-secrets when ready."
  else
    if confirm "Pull and decrypt the existing secrets with this YubiKey now?"; then
      exec "${SETUP_PATH}" pull-secrets
    fi
    info "Enrollment is complete. Run ./setup pull-secrets when ready."
  fi
}

status() (
  local output
  printf 'Identity locator file: %s\n' "${IDENTITY_FILE}"
  if [[ -r "${IDENTITY_FILE}" ]]; then
    printf 'Saved identity locators: %s\n' "$(awk 'NF { count++ } END { print count + 0 }' "${IDENTITY_FILE}")"
  else
    printf 'Saved identity locators: 0\n'
  fi
  printf 'Recipient file: %s\n' "${RECIPIENTS_FILE}"
  if [[ -r "${RECIPIENTS_FILE}" ]]; then
    awk 'NF { print "  " $0 }' "${RECIPIENTS_FILE}"
  else
    printf '  none\n'
  fi

  output="$(mktemp)"
  trap 'rm -f "${output:-}"' EXIT
  if run_plugin --identity > "${output}" && grep -q '^AGE-PLUGIN-YUBIKEY-' "${output}"; then
    printf '\nConnected YubiKey identities:\n'
    cat "${output}"
  else
    warn "No hardware-backed Age identity is visible on a connected YubiKey."
  fi
)

test_connected() (
  local output
  start_linux_pcscd
  release_gpg_smartcard
  output="$(mktemp)"
  trap 'rm -f "${output:-}"' EXIT
  connected_identity_output "${output}"
  test_material "${output}"
)

main() {
  local action="${1:---enroll}"
  [[ $# -le 1 ]] || fail "Only one action may be supplied."
  case "${action}" in
    --enroll|--enroll-only|--repair-management-key|--status|--test) ;;
    -h|--help) usage; return 0 ;;
    *) usage >&2; fail "Unknown action: ${action}" ;;
  esac

  require_normal_user
  if [[ "${action}" != "--repair-management-key" ]]; then
    ensure_dependencies "$@"
  fi
  case "${action}" in
    --enroll) enroll yes ;;
    --enroll-only) enroll no ;;
    --repair-management-key) repair_management_key ;;
    --status) status ;;
    --test) test_connected ;;
  esac
}

main "$@"
