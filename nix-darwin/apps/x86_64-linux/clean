#!/usr/bin/env bash

set -Eeuo pipefail

readonly FLAKE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"

case "$(uname -m)" in
  x86_64) detected_system=x86_64-linux ;;
  aarch64|arm64) detected_system=aarch64-linux ;;
  *) printf 'error: unsupported architecture: %s\n' "$(uname -m)" >&2; exit 1 ;;
esac
readonly SYSTEM_CONFIG="${SYSTEM_CONFIG:-${detected_system}}"

printf '\033[1;33mCleaning system generations older than seven days...\033[0m\n'
if [[ -e /etc/NIXOS ]]; then
  sudo nix-collect-garbage --delete-older-than 7d

  printf '\033[1;33mRebuilding the boot files for %s...\033[0m\n' "${SYSTEM_CONFIG}"
  sudo nixos-rebuild boot \
    --flake "path:${FLAKE_DIR}#${SYSTEM_CONFIG}" \
    --install-bootloader

  printf '\033[1;32mCleanup complete.\033[0m\n'
  df -h /boot
else
  nix-collect-garbage --delete-older-than 7d
  nix store optimise
  printf '\033[1;32mHome Manager and user-profile cleanup complete.\033[0m\n'
  df -h "${HOME}"
fi
