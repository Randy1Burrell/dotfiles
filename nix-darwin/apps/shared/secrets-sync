#!/usr/bin/env bash

set -Eeuo pipefail
umask 0077

readonly SECRETS_REMOTE="${SECRETS_REMOTE:-ssh://git@github.com/randy1burrell/secrets.git}"
readonly SECRETS_BRANCH="${SECRETS_BRANCH:-main}"
readonly SSH_DIR="${HOME}/.ssh"
readonly AGENIX_PRIVATE_KEY="${AGENIX_IDENTITY_PATH:-${SSH_DIR}/id_ed25519_agenix}"
readonly AGENIX_PUBLIC_KEY="${AGENIX_PRIVATE_KEY}.pub"
readonly DEFAULT_PUBLIC_KEY="${SSH_DIR}/id_ed25519.pub"
readonly CONFIG_EXTERNAL_FALLBACK="${SECRETS_CONFIG_EXTERNAL_FALLBACK:-}"

selected_identity=""
ssh_command=""

info() {
  printf '\033[1;34m==>\033[0m %s\n' "$*"
}

warn() {
  printf '\033[1;33mwarning:\033[0m %s\n' "$*" >&2
}

fail() {
  printf '\033[1;31merror:\033[0m %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "$1 is required for secrets synchronization."
}

ensure_gpg_agent_compatible() {
  local expected_version running_version

  command -v gpg-agent >/dev/null 2>&1 || return 0
  command -v gpgconf >/dev/null 2>&1 || return 0
  command -v gpg-connect-agent >/dev/null 2>&1 || return 0

  gpgconf --launch gpg-agent >/dev/null 2>&1 || return 0
  expected_version="$(gpg-agent --version 2>/dev/null | awk 'NR == 1 { print $3; exit }')"
  running_version="$(
    gpg-connect-agent 'GETINFO version' /bye 2>/dev/null |
      awk '$1 == "D" { print $2; exit }' || true
  )"

  if [[ -n "${expected_version}" && -n "${running_version}" && "${running_version}" != "${expected_version}" ]]; then
    warn "Restarting stale gpg-agent ${running_version} with managed version ${expected_version}."
    gpgconf --kill all >/dev/null 2>&1 || true
    gpgconf --launch gpg-agent >/dev/null 2>&1 || \
      fail "Could not launch the managed gpg-agent ${expected_version}."
    running_version="$(
      gpg-connect-agent 'GETINFO version' /bye 2>/dev/null |
        awk '$1 == "D" { print $2; exit }' || true
    )"
    [[ "${running_version}" == "${expected_version}" ]] || \
      fail "Expected gpg-agent ${expected_version}, but socket reports ${running_version:-unknown}."
  fi

  if [[ -t 0 ]]; then
    export GPG_TTY
    GPG_TTY="$(tty)"
    gpg-connect-agent --quiet updatestartuptty /bye >/dev/null 2>&1 || true
  fi
}

set_identity() {
  selected_identity="$1"
  printf -v ssh_command 'ssh -i %q -o IdentitiesOnly=yes' "${selected_identity}"
}

remote_is_accessible() {
  if [[ -n "${ssh_command}" ]]; then
    GIT_SSH_COMMAND="${ssh_command}" \
      git ls-remote --exit-code "${SECRETS_REMOTE}" "refs/heads/${SECRETS_BRANCH}" >/dev/null 2>&1
  else
    git ls-remote --exit-code "${SECRETS_REMOTE}" "refs/heads/${SECRETS_BRANCH}" >/dev/null 2>&1
  fi
}

select_git_identity() {
  local candidate

  if [[ -n "${SECRETS_SSH_IDENTITY:-}" ]]; then
    [[ -r "${SECRETS_SSH_IDENTITY}" ]] || \
      fail "Secrets SSH identity is not readable: ${SECRETS_SSH_IDENTITY}"
    set_identity "${SECRETS_SSH_IDENTITY}"
    remote_is_accessible || fail "${SECRETS_SSH_IDENTITY} cannot read ${SECRETS_REMOTE}."
    return 0
  fi

  selected_identity=""
  ssh_command=""
  if remote_is_accessible; then
    info "Using the active GPG-backed SSH agent for the private secrets repository"
    return 0
  fi

  # File-backed identities are recovery fallbacks only. An explicit
  # SECRETS_SSH_IDENTITY remains available when a token cannot be used.
  for candidate in "${SSH_DIR}/id_ed25519" "${SSH_DIR}/id_rsa"; do
    [[ -r "${candidate}" ]] || continue
    set_identity "${candidate}"
    if remote_is_accessible; then
      warn "Using recovery identity ${candidate} for the private secrets repository"
      return 0
    fi
  done

  fail "No GPG-backed SSH-agent or recovery identity can read ${SECRETS_REMOTE}."
}

repository_git() {
  if [[ -n "${ssh_command}" ]]; then
    GIT_SSH_COMMAND="${ssh_command}" git "$@"
  else
    git "$@"
  fi
}

make_workspace() {
  local workspace
  workspace="$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-secrets.XXXXXX")"
  [[ -n "${workspace}" && -d "${workspace}" ]] || fail "Could not create a secrets workspace."
  printf '%s\n' "${workspace}"
}

clone_repository() {
  local destination="$1"
  repository_git clone --branch "${SECRETS_BRANCH}" "${SECRETS_REMOTE}" "${destination}"
}

confirm() {
  local prompt="$1" reply

  if [[ "${SECRETS_CONFIRM:-}" == "yes" ]]; then
    return 0
  fi

  [[ -t 0 ]] || fail "Confirmation is required. Re-run interactively or set SECRETS_CONFIRM=yes."
  read -r -p "${prompt} [y/N] " reply
  [[ "${reply}" =~ ^[Yy]$ ]]
}

public_key_value() {
  awk 'NF >= 2 { print $1 " " $2; exit }' "$1"
}

create_rules_if_missing() {
  local repository="$1" rules
  local agenix_recipient default_recipient

  rules="${repository}/secrets.nix"

  [[ -e "${rules}" ]] && return 0

  agenix_recipient="$(public_key_value "${AGENIX_PUBLIC_KEY}")"
  default_recipient="$(public_key_value "${DEFAULT_PUBLIC_KEY}")"
  [[ -n "${agenix_recipient}" && -n "${default_recipient}" ]] || \
    fail "Could not read the SSH recipients used to create secrets.nix."

  {
    printf 'let\n'
    printf '  agenixIdentity = "%s";\n' "${agenix_recipient}"
    printf '  defaultIdentity = "%s";\n' "${default_recipient}"
    printf '  recipients = [ agenixIdentity defaultIdentity ];\n'
    printf 'in\n'
    printf '{\n'
    printf '  "id_rsa.age".publicKeys = recipients;\n'
    printf '  "authorized_keys.age".publicKeys = recipients;\n'
    printf '  "config_external.age".publicKeys = recipients;\n'
    printf '}\n'
  } > "${rules}"

  info "Created Agenix recipient rules"
}

encrypt_file() {
  local source="$1" destination="$2" temporary

  temporary="${destination}.new"

  age --encrypt \
    --recipients-file "${AGENIX_PUBLIC_KEY}" \
    --recipients-file "${DEFAULT_PUBLIC_KEY}" \
    --output "${temporary}" \
    "${source}"
  mv -- "${temporary}" "${destination}"
}

push_secrets() (
  local workspace repository config_source
  workspace="$(make_workspace)"
  trap 'rm -rf -- "${workspace}"' EXIT
  repository="${workspace}/repository"

  [[ -r "${SSH_DIR}/id_rsa" ]] || fail "Missing ${SSH_DIR}/id_rsa."
  [[ -r "${SSH_DIR}/authorized_keys" ]] || fail "Missing ${SSH_DIR}/authorized_keys."
  [[ -r "${AGENIX_PUBLIC_KEY}" ]] || fail "Missing ${AGENIX_PUBLIC_KEY}."
  [[ -r "${DEFAULT_PUBLIC_KEY}" ]] || fail "Missing ${DEFAULT_PUBLIC_KEY}."

  config_source="${SSH_DIR}/config_external"
  if [[ ! -r "${config_source}" && -n "${CONFIG_EXTERNAL_FALLBACK}" && -r "${CONFIG_EXTERNAL_FALLBACK}" ]]; then
    config_source="${CONFIG_EXTERNAL_FALLBACK}"
    warn "Using retained config_external source at ${CONFIG_EXTERNAL_FALLBACK}."
  fi
  [[ -r "${config_source}" ]] || fail "Missing ${SSH_DIR}/config_external."

  select_git_identity
  clone_repository "${repository}"
  create_rules_if_missing "${repository}"

  info "Encrypting local secrets; plaintext will not enter the Git repository"
  encrypt_file "${SSH_DIR}/id_rsa" "${repository}/id_rsa.age"
  encrypt_file "${SSH_DIR}/authorized_keys" "${repository}/authorized_keys.age"
  encrypt_file "${config_source}" "${repository}/config_external.age"

  repository_git -C "${repository}" status --short
  if repository_git -C "${repository}" diff --quiet -- . && \
     repository_git -C "${repository}" diff --cached --quiet -- . && \
     [[ -z "$(repository_git -C "${repository}" ls-files --others --exclude-standard)" ]]; then
    info "The encrypted secrets repository is already current"
    return 0
  fi

  confirm "Commit and push these encrypted secret files to ${SECRETS_REMOTE}?" || \
    fail "Secrets push cancelled."

  ensure_gpg_agent_compatible
  repository_git -C "${repository}" add -- \
    secrets.nix id_rsa.age authorized_keys.age config_external.age
  repository_git -C "${repository}" commit -m "chore: update encrypted workstation secrets" || \
    fail "Could not create the signed commit. Complete any GPG PIN or security-key touch prompt, then retry."
  repository_git -C "${repository}" push origin "${SECRETS_BRANCH}"
  info "Encrypted secrets pushed successfully"
)

decrypt_file() {
  local source="$1" destination="$2"
  age --decrypt --identity "${AGENIX_PRIVATE_KEY}" --output "${destination}" "${source}"
}

pull_secrets() (
  local workspace repository decrypted backup_suffix name target
  workspace="$(make_workspace)"
  trap 'rm -rf -- "${workspace}"' EXIT
  repository="${workspace}/repository"
  decrypted="${workspace}/decrypted"
  backup_suffix="$(date +%Y%m%d%H%M%S).$$"

  [[ -r "${AGENIX_PRIVATE_KEY}" ]] || fail "Missing decryption identity ${AGENIX_PRIVATE_KEY}. Run copy-keys first."

  select_git_identity
  clone_repository "${repository}"
  install -d -m 700 "${decrypted}"

  for name in id_rsa authorized_keys config_external; do
    [[ -r "${repository}/${name}.age" ]] || fail "The secrets repository is missing ${name}.age."
    decrypt_file "${repository}/${name}.age" "${decrypted}/${name}"
  done

  ssh-keygen -lf "${decrypted}/id_rsa" >/dev/null || fail "Decrypted id_rsa is not a valid SSH key."
  ssh-keygen -lf "${decrypted}/authorized_keys" >/dev/null || fail "Decrypted authorized_keys is not a valid SSH public-key file."
  [[ -s "${decrypted}/config_external" ]] || fail "Decrypted config_external is empty."

  confirm "Back up existing files and install the decrypted secrets into ${SSH_DIR}?" || \
    fail "Secrets installation cancelled."

  install -d -m 700 "${SSH_DIR}"
  for name in id_rsa authorized_keys config_external; do
    target="${SSH_DIR}/${name}"
    if [[ -e "${target}" || -L "${target}" ]]; then
      cp -p -- "${target}" "${target}.bk.${backup_suffix}"
      info "Backed up ${target} to ${target}.bk.${backup_suffix}"
    fi
    install -m 600 "${decrypted}/${name}" "${target}"
  done

  ssh-keygen -y -f "${SSH_DIR}/id_rsa" > "${decrypted}/id_rsa.pub"
  install -m 644 "${decrypted}/id_rsa.pub" "${SSH_DIR}/id_rsa.pub"
  info "Secrets decrypted and installed successfully"
)

usage() {
  printf 'Usage: %s <push|pull>\n' "${BASH_SOURCE[0]}"
}

main() {
  require_command age
  require_command awk
  require_command git
  require_command install
  require_command mktemp
  require_command ssh
  require_command ssh-keygen

  case "${1:-}" in
    push) push_secrets ;;
    pull) pull_secrets ;;
    -h|--help) usage ;;
    *) usage >&2; fail "Expected push or pull action." ;;
  esac
}

main "$@"
