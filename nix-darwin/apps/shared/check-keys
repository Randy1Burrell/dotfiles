#!/usr/bin/env bash

set -Eeuo pipefail

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly SSH_DIR="${HOME}/.ssh"

"${SCRIPT_DIR}/gpg"
export SSH_AUTH_SOCK
SSH_AUTH_SOCK="$(gpgconf --list-dirs agent-ssh-socket)"

missing=0
for key_file in id_ed25519 id_ed25519.pub id_ed25519_agenix id_ed25519_agenix.pub; do
  if [[ ! -f "${SSH_DIR}/${key_file}" ]]; then
    printf 'Missing: %s\n' "${SSH_DIR}/${key_file}" >&2
    missing=1
  fi
done

if [[ ${missing} -ne 0 ]]; then
  printf 'Run create-keys or copy-keys to install the missing files.\n' >&2
  exit 1
fi

printf 'All SSH and Agenix key files are present, and SSH_AUTH_SOCK uses gpg-agent.\n'
