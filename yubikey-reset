#!/usr/bin/env bash

set -Eeuo pipefail
umask 0077

resolve_script_path() {
  local source="${BASH_SOURCE[0]}" directory target
  if [[ "${source}" != */* ]]; then
    source="$(command -v -- "${source}")"
  fi
  while [[ -L "${source}" ]]; do
    directory="$(cd -P -- "$(dirname -- "${source}")" && pwd)"
    target="$(readlink "${source}")"
    if [[ "${target}" == /* ]]; then
      source="${target}"
    else
      source="${directory}/${target}"
    fi
  done
  directory="$(cd -P -- "$(dirname -- "${source}")" && pwd)"
  printf '%s/%s\n' "${directory}" "$(basename -- "${source}")"
}

SCRIPT_PATH="$(resolve_script_path)"
readonly SCRIPT_PATH
ORIGINAL_ARGUMENTS=("$@")
SERIAL=""
DEVICE_INFO=""

info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mwarning:\033[0m %s\n' "$*" >&2; }
fail() { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<EOF
Usage: $(basename "${SCRIPT_PATH}") [SERIAL]

Immediately and permanently erase all resettable user data from exactly one
connected YubiKey. No confirmation prompt is shown. If SERIAL is supplied, the
connected key must have that serial number.

This destroys FIDO2/U2F credentials and passkeys, OATH accounts, OpenPGP keys,
PIV keys and certificates (including Agenix and local-login keys), YubiHSM Auth
credentials, Security Domain keys, and both configurable OTP slots.

FIDO reset still requires the hardware action mandated by Yubico: insert the
key immediately before running this script and touch it when it flashes.

Optional non-interactive credentials for protected configuration:

  YUBIKEY_OTP_SLOT1_ACCESS_CODE  Current 12-hex-character OTP slot 1 code
  YUBIKEY_OTP_SLOT2_ACCESS_CODE  Current 12-hex-character OTP slot 2 code
  YUBIKEY_CONFIG_LOCK_CODE       Current 32-hex-character configuration code

On a regular YubiKey 5, Yubico does not provide one universal factory-reset
command. This script resets each application. It clears OTP slots but cannot
recreate the unique Yubico OTP credential originally installed at the factory.
EOF
}

ensure_ykman() {
  command -v ykman >/dev/null 2>&1 && return 0

  if [[ -z "${YUBIKEY_RESET_NIX_SHELL:-}" ]] && command -v nix >/dev/null 2>&1; then
    info "Loading YubiKey Manager from Nix"
    exec nix --extra-experimental-features 'nix-command flakes' shell \
      nixpkgs#yubikey-manager \
      --command env YUBIKEY_RESET_NIX_SHELL=1 \
      "${SCRIPT_PATH}" "${ORIGINAL_ARGUMENTS[@]}"
  fi

  fail "ykman is required. Install YubiKey Manager or Nix, then retry."
}

detect_card() {
  local expected_serial="${1:-}" serials count
  serials="$(ykman list --serials 2>/dev/null | awk '/^[0-9]+$/ { print }')"

  if [[ -n "${expected_serial}" ]]; then
    [[ "${expected_serial}" =~ ^[0-9]+$ ]] || fail "SERIAL must contain only digits."
    printf '%s\n' "${serials}" | grep -Fxq -- "${expected_serial}" || \
      fail "YubiKey ${expected_serial} is not connected. Nothing was reset."
    count="$(printf '%s\n' "${serials}" | awk 'NF { count++ } END { print count + 0 }')"
    (( count == 1 )) || fail "Disconnect every YubiKey except ${expected_serial}. Nothing was reset."
    SERIAL="${expected_serial}"
    return 0
  fi

  count="$(printf '%s\n' "${serials}" | awk 'NF { count++ } END { print count + 0 }')"
  case "${count}" in
    0) fail "No YubiKey is connected. Nothing was reset." ;;
    1) SERIAL="$(printf '%s\n' "${serials}" | awk 'NF { print; exit }')" ;;
    *) fail "More than one YubiKey is connected. Supply a serial and disconnect the others." ;;
  esac
}

run_ykman() {
  ykman --device "${SERIAL}" "$@"
}

supports_application() {
  local name="$1"
  printf '%s\n' "${DEVICE_INFO}" | grep -Eq "^${name}[[:space:]]"
}

reset_otp_slot() {
  local slot="$1" otp_info="$2" access_code_variable access_code
  if printf '%s\n' "${otp_info}" |
     grep -Eiq "^Slot ${slot}:[[:space:]]*(empty|not configured)"; then
    info "OTP slot ${slot} is already empty"
    return 0
  fi
  printf '%s\n' "${otp_info}" |
    grep -Eiq "^Slot ${slot}:[[:space:]]*(programmed|configured)" || \
    fail "Could not determine whether OTP slot ${slot} is configured."

  access_code_variable="YUBIKEY_OTP_SLOT${slot}_ACCESS_CODE"
  access_code="${!access_code_variable:-}"
  if [[ -n "${access_code}" ]]; then
    [[ "${access_code}" =~ ^[0-9A-Fa-f]{12}$ ]] || \
      fail "${access_code_variable} must contain exactly 12 hexadecimal characters."
    run_ykman otp --access-code "${access_code}" delete --force "${slot}"
  else
    run_ykman otp delete --force "${slot}" || \
      fail "OTP slot ${slot} could not be cleared. If it is protected, set ${access_code_variable} and rerun."
  fi
}

clear_configuration_lock() {
  local lock_code="${YUBIKEY_CONFIG_LOCK_CODE:-}"
  [[ -n "${lock_code}" ]] || return 0
  run_ykman config set-lock-code --clear --force --lock-code "${lock_code}"
}

validate_optional_credentials() {
  local variable value
  for variable in YUBIKEY_OTP_SLOT1_ACCESS_CODE YUBIKEY_OTP_SLOT2_ACCESS_CODE; do
    value="${!variable:-}"
    [[ -z "${value}" || "${value}" =~ ^[0-9A-Fa-f]{12}$ ]] || \
      fail "${variable} must contain exactly 12 hexadecimal characters. Nothing was reset."
  done

  value="${YUBIKEY_CONFIG_LOCK_CODE:-}"
  [[ -z "${value}" || "${value}" =~ ^[0-9A-Fa-f]{32}$ ]] || \
    fail "YUBIKEY_CONFIG_LOCK_CODE must contain exactly 32 hexadecimal characters. Nothing was reset."

  if printf '%s\n' "${DEVICE_INFO}" |
     grep -Fq 'Configured capabilities are protected by a lock code'; then
    [[ -n "${value}" ]] || \
      fail "The YubiKey configuration is locked. Set YUBIKEY_CONFIG_LOCK_CODE and rerun; nothing was reset."
  fi
}

reset_regular_yubikey() {
  local otp_info

  if supports_application 'FIDO U2F' || supports_application 'FIDO2'; then
    info "Resetting FIDO2/U2F; touch YubiKey ${SERIAL} when it flashes"
    run_ykman fido reset --force || \
      fail "FIDO reset failed. Remove the YubiKey, reinsert it, and immediately rerun this script."
  fi

  command -v gpgconf >/dev/null 2>&1 && gpgconf --kill scdaemon >/dev/null 2>&1 || true

  if supports_application 'Yubico OTP'; then
    info "Clearing both configurable OTP slots"
    otp_info="$(run_ykman otp info)"
    reset_otp_slot 1 "${otp_info}"
    reset_otp_slot 2 "${otp_info}"
  fi

  supports_application 'OATH' && run_ykman oath reset --force
  supports_application 'OpenPGP' && run_ykman openpgp reset --force
  supports_application 'PIV' && run_ykman piv reset --force
  supports_application 'YubiHSM Auth' && run_ykman hsmauth reset --force

  if ykman --full-help 2>&1 | grep -Eq '^[[:space:]]+sd[[:space:]]'; then
    run_ykman sd reset --force
  fi

  clear_configuration_lock
  run_ykman config usb --enable-all --force
  if printf '%s\n' "${DEVICE_INFO}" | grep -Eq '^NFC transport is (enabled|disabled)$'; then
    run_ykman config nfc --enable-all --force
  fi
}

main() {
  case "$#" in
    0) ;;
    1)
      case "$1" in
        -h|--help) usage; return 0 ;;
      esac
      ;;
    *) usage >&2; fail "Expected at most one serial number." ;;
  esac

  ensure_ykman
  detect_card "${1:-}"
  DEVICE_INFO="$(run_ykman info)"
  validate_optional_credentials

  warn "Permanently erasing every resettable credential on YubiKey ${SERIAL}; no confirmation will be requested."
  printf '%s\n' "${DEVICE_INFO}"

  if printf '%s\n' "${DEVICE_INFO}" | grep -Eiq 'Bio.*Multi-protocol|Multi-protocol.*Bio'; then
    run_ykman config reset --force
  else
    reset_regular_yubikey
  fi

  info "YubiKey ${SERIAL} reset completed"
  warn "Remove and reinsert the card before provisioning it again."
}

main "$@"
