# Keep the executable search path available even when zsh is started outside a
# graphical login session.  This file is loaded before .zshrc.
typeset -U path
path=(
  "$HOME/.custom_scripts"
  "$HOME/.volta/bin"
  "$HOME/.pyenv/bin"
  "$HOME/.pyenv/libexec"
  "$HOME/.yarn/bin"
  "$HOME/.cargo/bin"
  "$HOME/.ghcup/bin"
  /run/current-system/sw/bin
  /nix/var/nix/profiles/default/bin
  /opt/homebrew/opt/coreutils/libexec/gnubin
  /opt/homebrew/opt/llvm/bin
  /opt/homebrew/opt/ruby/bin
  /opt/homebrew/bin
  /opt/homebrew/sbin
  "$HOME/Library/Android/sdk/tools"
  "$HOME/Library/Android/sdk/tools/bin"
  "$HOME/Library/Android/sdk/emulator"
  "$HOME/Library/Android/sdk/platform-tools"
  $path
)
export PATH

umask 0077

export ANDROID_SDK_ROOT="$HOME/Library/Android/sdk"
export GOPATH="$HOME/Projects/Environments/Go"
export GEM_HOME="$HOME/.gem"
export PYENV_ROOT="$HOME/.pyenv"
export NVM_DIR="$HOME/.nvm"
export SWORD_PATH="$HOME/Library/Application Support/Sword"
export LANG=en_US.UTF-8

if [[ "$OSTYPE" == darwin* ]]; then
  export PKG_CONFIG_PATH="/opt/homebrew/opt/ruby/lib/pkgconfig:/opt/homebrew/lib/pkgconfig:/usr/local/lib/pkgconfig"
  export LDFLAGS="-L/opt/homebrew/opt/llvm/lib -L/opt/homebrew/opt/sqlite/lib -L/opt/homebrew/opt/ruby/lib"
  export CPPFLAGS="-I/opt/homebrew/opt/llvm/include -I/opt/homebrew/opt/sqlite/include -I/opt/homebrew/opt/ruby/include"
fi
