#!/usr/bin/env bash

set -Eeuo pipefail

VERSION=1.0

GREEN='\033[1;32m'
RED='\033[1;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

SYSTEM=$(uname -m)

case "$SYSTEM" in
  x86_64)
    FLAKE_TARGET="x86_64-linux"
    ;;
  aarch64)
    FLAKE_TARGET="aarch64-linux"
    ;;
  *)
    echo -e "${RED}Unsupported architecture: $SYSTEM${NC}"
    exit 1
    ;;
esac

echo -e "${YELLOW}Starting...${NC}"

if [[ -e /etc/NIXOS ]]; then
  if [[ "$(id -u)" -eq 0 ]]; then
    echo -e "${RED}Run nixos-rebuild as your normal NixOS user, not with sudo.${NC}" >&2
    exit 1
  fi
  if [[ -z "${HOME:-}" || "${HOME}" != /* || ! -d "${HOME}" ]]; then
    echo -e "${RED}HOME must be an existing absolute directory.${NC}" >&2
    exit 1
  fi
  export DOTFILES_NIXOS_USER="$(id -un)"
  export DOTFILES_NIXOS_HOME="${HOME}"
  # We pass SSH from user to root so root can download secrets from our private Github
  sudo DOTFILES_NIXOS_USER="${DOTFILES_NIXOS_USER}" \
    DOTFILES_NIXOS_HOME="${DOTFILES_NIXOS_HOME}" \
    SSH_AUTH_SOCK="${SSH_AUTH_SOCK:-}" \
    /run/current-system/sw/bin/nixos-rebuild switch --impure \
    --flake ".#${FLAKE_TARGET}" "$@"
else
  if [[ "$(id -u)" -eq 0 ]]; then
    echo -e "${RED}Run Home Manager as your normal Ubuntu user, not with sudo.${NC}" >&2
    exit 1
  fi
  if [[ -z "${HOME:-}" || "${HOME}" != /* || ! -d "${HOME}" ]]; then
    echo -e "${RED}HOME must be an existing absolute directory.${NC}" >&2
    exit 1
  fi
  export DOTFILES_LINUX_USER="$(id -un)"
  export DOTFILES_LINUX_HOME="${HOME}"
  FLAKE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
  result="$(nix --extra-experimental-features 'nix-command flakes' build \
    --impure --no-write-lock-file --no-link --print-out-paths \
    "path:${FLAKE_DIR}#homeConfigurations.${FLAKE_TARGET}.activationPackage")"
  backup_extension="bk-$(date +%Y%m%d%H%M%S)-$$"
  USER="${DOTFILES_LINUX_USER}" LOGNAME="${DOTFILES_LINUX_USER}" \
    HOME="${DOTFILES_LINUX_HOME}" \
    HOME_MANAGER_BACKUP_EXT="${backup_extension}" "${result}/activate"
fi

echo -e "${GREEN}Switch to new generation complete!${NC}"
