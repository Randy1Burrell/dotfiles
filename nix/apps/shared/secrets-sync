#!/usr/bin/env bash

set -Eeuo pipefail
umask 0077

readonly SECRETS_REMOTE="${SECRETS_REMOTE:-ssh://git@github.com/randy1burrell/secrets.git}"
readonly SECRETS_BRANCH="${SECRETS_BRANCH:-main}"
readonly SSH_DIR="${HOME}/.ssh"
readonly AGENIX_PRIVATE_KEY="${AGENIX_IDENTITY_PATH:-${SSH_DIR}/id_ed25519_agenix}"
readonly AGENIX_PUBLIC_KEY="${AGENIX_PRIVATE_KEY}.pub"
readonly DEFAULT_PUBLIC_KEY="${SSH_DIR}/id_ed25519.pub"
readonly AGE_CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/age"
readonly YUBIKEY_IDENTITY_FILE="${AGE_YUBIKEY_IDENTITY_PATH:-${AGE_CONFIG_DIR}/yubikey-identities.txt}"
readonly YUBIKEY_RECIPIENTS_FILE="${AGE_YUBIKEY_RECIPIENTS_PATH:-${AGE_CONFIG_DIR}/yubikey-recipients.txt}"
readonly CONFIG_EXTERNAL_FALLBACK="${SECRETS_CONFIG_EXTERNAL_FALLBACK:-}"
readonly SSH_ARCHIVE_NAME="ssh-directory.tar.gz"
readonly SSH_ARCHIVE_CIPHERTEXT="${SSH_ARCHIVE_NAME}.age"
readonly SSH_BACKUP_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/dotfiles/ssh-backups"

if [[ "$(uname -s)" == "Linux" && -x /usr/bin/ssh ]]; then
  readonly SSH_EXECUTABLE=/usr/bin/ssh
else
  SSH_EXECUTABLE="$(command -v ssh)"
fi
readonly SSH_EXECUTABLE

selected_identity=""
ssh_command=""
last_remote_error=""
age_identity_args=()

info() {
  printf '\033[1;34m==>\033[0m %s\n' "$*"
}

warn() {
  printf '\033[1;33mwarning:\033[0m %s\n' "$*" >&2
}

fail() {
  printf '\033[1;31merror:\033[0m %s\n' "$*" >&2
  exit 1
}

run_age() {
  # age-plugin-yubikey rejects C.UTF-8 as a language identifier even though it
  # is a valid system locale. Give the plugin an explicit language tag.
  LC_ALL="${AGE_YUBIKEY_LOCALE:-en_US.UTF-8}" \
    LANGUAGE="${AGE_YUBIKEY_LANGUAGE:-en-US}" \
    age "$@"
}

run_age_plugin() {
  LC_ALL="${AGE_YUBIKEY_LOCALE:-en_US.UTF-8}" \
    LANGUAGE="${AGE_YUBIKEY_LANGUAGE:-en-US}" \
    age-plugin-yubikey "$@"
}

release_gpg_smartcard_for_age() {
  local gpgconf_bin

  # The private repository is normally cloned through GPG-backed SSH. That
  # starts scdaemon, which can keep exclusive ownership of the YubiKey reader
  # and prevent age-plugin-yubikey from opening the PIV applet immediately
  # afterwards. Keep gpg-agent alive for SSH, but release only scdaemon before
  # Age touches the card.
  gpgconf_bin="${DOTFILES_GPGCONF:-}"
  if [[ -z "${gpgconf_bin}" ]]; then
    gpgconf_bin="$(command -v gpgconf 2>/dev/null || true)"
  fi
  [[ -n "${gpgconf_bin}" && -x "${gpgconf_bin}" ]] || return 0
  "${gpgconf_bin}" --kill scdaemon >/dev/null 2>&1 || true
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "$1 is required for secrets synchronization."
}

ensure_gpg_agent_compatible() {
  local expected_version running_version

  command -v gpg-agent >/dev/null 2>&1 || return 0
  command -v gpgconf >/dev/null 2>&1 || return 0
  command -v gpg-connect-agent >/dev/null 2>&1 || return 0

  gpgconf --launch gpg-agent >/dev/null 2>&1 || return 0
  expected_version="$(gpg-agent --version 2>/dev/null | awk 'NR == 1 { print $3; exit }')"
  running_version="$(
    gpg-connect-agent 'GETINFO version' /bye 2>/dev/null |
      awk '$1 == "D" { print $2; exit }' || true
  )"

  if [[ -n "${expected_version}" && -n "${running_version}" && "${running_version}" != "${expected_version}" ]]; then
    warn "Restarting stale gpg-agent ${running_version} with managed version ${expected_version}."
    gpgconf --kill all >/dev/null 2>&1 || true
    gpgconf --launch gpg-agent >/dev/null 2>&1 || \
      fail "Could not launch the managed gpg-agent ${expected_version}."
    running_version="$(
      gpg-connect-agent 'GETINFO version' /bye 2>/dev/null |
        awk '$1 == "D" { print $2; exit }' || true
    )"
    [[ "${running_version}" == "${expected_version}" ]] || \
      fail "Expected gpg-agent ${expected_version}, but socket reports ${running_version:-unknown}."
  fi

  if [[ -t 0 ]]; then
    export GPG_TTY
    GPG_TTY="$(tty)"
    gpg-connect-agent --quiet updatestartuptty /bye >/dev/null 2>&1 || true
  fi
}

set_identity() {
  selected_identity="$1"
  printf -v ssh_command \
    '%q -i %q -o IdentitiesOnly=yes' \
    "${SSH_EXECUTABLE}" "${selected_identity}"
}

set_agent_identity() {
  local socket="${SSH_AUTH_SOCK:-}"

  if [[ -z "${socket}" ]] && command -v gpgconf >/dev/null 2>&1; then
    socket="$(gpgconf --list-dirs agent-ssh-socket 2>/dev/null || true)"
  fi
  [[ -n "${socket}" ]] || return 1

  selected_identity=""
  printf -v ssh_command \
    '%q -o IdentityAgent=%q -o IdentityFile=none -o IdentitiesOnly=no' \
    "${SSH_EXECUTABLE}" "${socket}"
}

remote_is_accessible() {
  local command_output

  if [[ -n "${ssh_command}" ]]; then
    if command_output="$(
      GIT_SSH_COMMAND="${ssh_command}" \
        git ls-remote --exit-code "${SECRETS_REMOTE}" \
          "refs/heads/${SECRETS_BRANCH}" 2>&1 >/dev/null
    )"; then
      last_remote_error=""
      return 0
    fi
  else
    if command_output="$(
      git ls-remote --exit-code "${SECRETS_REMOTE}" \
        "refs/heads/${SECRETS_BRANCH}" 2>&1 >/dev/null
    )"; then
      last_remote_error=""
      return 0
    fi
  fi
  last_remote_error="${command_output}"
  return 1
}

select_git_identity() {
  local agent_error="" candidate

  if [[ -n "${SECRETS_SSH_IDENTITY:-}" ]]; then
    [[ -r "${SECRETS_SSH_IDENTITY}" ]] || \
      fail "Secrets SSH identity is not readable: ${SECRETS_SSH_IDENTITY}"
    set_identity "${SECRETS_SSH_IDENTITY}"
    remote_is_accessible || fail "${SECRETS_SSH_IDENTITY} cannot read ${SECRETS_REMOTE}."
    return 0
  fi

  if set_agent_identity; then
    if remote_is_accessible; then
      info "Using the active GPG-backed SSH agent for the private secrets repository"
      return 0
    fi
    agent_error="${last_remote_error}"
  fi

  for candidate in "${SSH_DIR}/id_ed25519" "${SSH_DIR}/id_rsa"; do
    [[ -r "${candidate}" ]] || continue
    set_identity "${candidate}"
    if remote_is_accessible; then
      warn "Using migration fallback ${candidate} for the private secrets repository"
      return 0
    fi
  done

  if [[ -n "${agent_error}" ]]; then
    warn "The GPG-backed SSH attempt failed with:"
    while IFS= read -r line; do
      printf '  %s\n' "${line}" >&2
    done <<< "${agent_error}"
  elif command -v ssh-add >/dev/null 2>&1; then
    warn "The GPG-backed SSH socket did not expose a usable identity:"
    SSH_AUTH_SOCK="${SSH_AUTH_SOCK:-}" ssh-add -l >&2 || true
  fi
  fail "No GPG-backed SSH-agent or file-backed migration identity can read ${SECRETS_REMOTE}. Run ./setup github-ssh-key to authorize the connected card, then retry."
}

repository_git() {
  if [[ -n "${ssh_command}" ]]; then
    GIT_SSH_COMMAND="${ssh_command}" git "$@"
  else
    git "$@"
  fi
}

make_workspace() {
  local workspace
  workspace="$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-secrets.XXXXXX")"
  [[ -n "${workspace}" && -d "${workspace}" ]] || fail "Could not create a secrets workspace."
  printf '%s\n' "${workspace}"
}

clone_repository() {
  local destination="$1"
  repository_git clone --branch "${SECRETS_BRANCH}" "${SECRETS_REMOTE}" "${destination}"
}

confirm() {
  local prompt="$1" reply

  if [[ "${SECRETS_CONFIRM:-}" == "yes" ]]; then
    return 0
  fi

  [[ -t 0 ]] || fail "Confirmation is required. Re-run interactively or set SECRETS_CONFIRM=yes."
  read -r -p "${prompt} [y/N] " reply
  [[ "${reply}" =~ ^[Yy]$ ]]
}

public_key_value() {
  awk 'NF >= 2 { print $1 " " $2; exit }' "$1"
}

collect_yubikey_recipients() {
  local repository="$1" rules
  rules="${repository}/secrets.nix"
  {
    if [[ -r "${rules}" ]]; then
      grep -Eo 'age1yubikey1[0-9a-z]+' "${rules}" || true
    fi
    if [[ -r "${YUBIKEY_RECIPIENTS_FILE}" ]]; then
      awk '/^age1yubikey1[0-9a-z]+$/ { print }' "${YUBIKEY_RECIPIENTS_FILE}"
    fi
  } | awk 'NF && !seen[$0]++ { print }'
}

sync_recipient_rules() {
  local repository="$1" yubikey_recipients="$2" rules temporary recipient
  local agenix_recipient default_recipient

  rules="${repository}/secrets.nix"
  temporary="${rules}.new"

  agenix_recipient="$(public_key_value "${AGENIX_PUBLIC_KEY}")"
  default_recipient="$(public_key_value "${DEFAULT_PUBLIC_KEY}")"
  [[ -n "${agenix_recipient}" && -n "${default_recipient}" ]] || \
    fail "Could not read the SSH recipients used to create secrets.nix."

  {
    printf 'let\n'
    printf '  agenixIdentity = "%s";\n' "${agenix_recipient}"
    printf '  defaultIdentity = "%s";\n' "${default_recipient}"
    printf '  yubikeyIdentities = [\n'
    if [[ -r "${yubikey_recipients}" ]]; then
      while IFS= read -r recipient; do
        [[ "${recipient}" == age1yubikey1* ]] || continue
        printf '    "%s"\n' "${recipient}"
      done < "${yubikey_recipients}"
    fi
    printf '  ];\n'
    printf '  recipients = [ agenixIdentity defaultIdentity ] ++ yubikeyIdentities;\n'
    printf 'in\n'
    printf '{\n'
    printf '  "id_rsa.age".publicKeys = recipients;\n'
    printf '  "authorized_keys.age".publicKeys = recipients;\n'
    printf '  "config_external.age".publicKeys = recipients;\n'
    printf '  "%s".publicKeys = recipients;\n' "${SSH_ARCHIVE_CIPHERTEXT}"
    printf '}\n'
  } > "${temporary}"

  if [[ -e "${rules}" ]] && cmp -s "${temporary}" "${rules}"; then
    rm -f -- "${temporary}"
  else
    mv -- "${temporary}" "${rules}"
    info "Updated Agenix recipient rules"
  fi
}

encrypt_file() {
  local source="$1" destination="$2" yubikey_recipients="$3" temporary
  local -a recipient_args

  temporary="${destination}.new"
  recipient_args=(
    --recipients-file "${AGENIX_PUBLIC_KEY}"
    --recipients-file "${DEFAULT_PUBLIC_KEY}"
  )
  if [[ -s "${yubikey_recipients}" ]]; then
    recipient_args+=(--recipients-file "${yubikey_recipients}")
  fi

  run_age --encrypt \
    "${recipient_args[@]}" \
    --output "${temporary}" \
    "${source}"
  mv -- "${temporary}" "${destination}"
}

create_ssh_archive() {
  local destination="$1" manifest

  manifest="${destination}.manifest"
  install -d -m 700 "$(dirname "${destination}")"

  # Keep the recovery identities outside the archive they are needed to
  # decrypt. Home Manager owns config, and runtime sockets/backups do not
  # belong in a portable workstation snapshot. Only regular files are added,
  # so symlinks, sockets, and device nodes can never enter the archive.
  (
    cd "${SSH_DIR}"
    find . \
      \( \
        -path './agent' -o \
        -path './agent/*' -o \
        -path './config' -o \
        -path './id_ed25519' -o \
        -path './id_ed25519.pub' -o \
        -path './id_ed25519_agenix' -o \
        -path './id_ed25519_agenix.pub' -o \
        -name '*.bk' -o \
        -name '*.bk.*' -o \
        -name '*.swp' -o \
        -name '*~' -o \
        -name '.DS_Store' -o \
        -name 'master-*' \
      \) -prune -o \
      -type f -print0
  ) > "${manifest}"

  tar \
    --create \
    --gzip \
    --file "${destination}" \
    --directory "${SSH_DIR}" \
    --null \
    --files-from "${manifest}"
  chmod 600 "${destination}"
  rm -f -- "${manifest}"
}

validate_ssh_archive() {
  local archive="$1" entry component
  local -a components

  tar --list --gzip --file "${archive}" >/dev/null || \
    fail "The decrypted SSH directory archive is invalid."

  # Reject links and special files before extraction. Both bsdtar and GNU tar
  # place the entry type in the first character of verbose listings.
  if ! tar --list --verbose --gzip --file "${archive}" |
    awk 'substr($0, 1, 1) != "-" && substr($0, 1, 1) != "d" { exit 1 }'; then
    fail "The decrypted SSH directory archive contains a link or special file."
  fi

  while IFS= read -r entry; do
    entry="${entry#./}"
    [[ -n "${entry}" && "${entry}" != "." ]] || continue
    [[ "${entry}" != /* ]] || \
      fail "The SSH directory archive contains an absolute path."

    IFS='/' read -r -a components <<< "${entry}"
    for component in "${components[@]}"; do
      [[ "${component}" != ".." ]] || \
        fail "The SSH directory archive contains an unsafe parent path."
    done

    case "${entry}" in
      config|agent|agent/*|id_ed25519|id_ed25519.pub|id_ed25519_agenix|id_ed25519_agenix.pub)
        fail "The SSH directory archive contains reserved path ${entry}."
        ;;
      *.bk|*.bk.*|*.swp|*~|.DS_Store|master-*|*/master-*)
        fail "The SSH directory archive contains transient path ${entry}."
        ;;
    esac
  done < <(tar --list --gzip --file "${archive}")
}

prepare_ssh_restore() {
  local archive="$1" restore_root="$2" unexpected restored_file

  validate_ssh_archive "${archive}"
  install -d -m 700 "${restore_root}"
  tar --extract --gzip --file "${archive}" --directory "${restore_root}"

  unexpected="$(find "${restore_root}" ! -type d ! -type f -print -quit)"
  [[ -z "${unexpected}" ]] || \
    fail "The SSH directory archive extracted an unsupported entry: ${unexpected}"
  find "${restore_root}" -type d -exec chmod 700 {} +
  find "${restore_root}" -type f -exec chmod go-rwx {} +
  restored_file="$(find "${restore_root}" -type f -print -quit)"
  [[ -n "${restored_file}" ]] || fail "The decrypted SSH directory archive is empty."
}

ensure_safe_restore_parent() {
  local relative="$1" parent_relative current component
  local -a components

  parent_relative="${relative%/*}"
  [[ "${parent_relative}" != "${relative}" ]] || return 0

  current="${SSH_DIR}"
  IFS='/' read -r -a components <<< "${parent_relative}"
  for component in "${components[@]}"; do
    [[ -n "${component}" && "${component}" != "." ]] || continue
    current="${current}/${component}"
    [[ ! -L "${current}" ]] || \
      fail "Refusing to restore through existing symlink ${current}."
    if [[ -e "${current}" ]]; then
      [[ -d "${current}" ]] || \
        fail "Refusing to replace non-directory restore parent ${current}."
    else
      install -d -m 700 "${current}"
    fi
  done
}

restore_ssh_archive() {
  local restore_root="$1" restored_file relative target restored_count=0

  while IFS= read -r -d '' restored_file; do
    relative="${restored_file#"${restore_root}/"}"
    ensure_safe_restore_parent "${relative}"
    target="${SSH_DIR}/${relative}"
    [[ ! -L "${target}" ]] || \
      fail "Refusing to replace existing symlink ${target}."
    [[ ! -d "${target}" ]] || \
      fail "Refusing to replace existing directory ${target} with a file."
    cp -p -- "${restored_file}" "${target}"
    restored_count=$((restored_count + 1))
  done < <(find "${restore_root}" -type f -print0)

  info "Restored ${restored_count} durable files from the encrypted SSH directory archive"
}

push_secrets() (
  local workspace repository config_source yubikey_recipients ssh_archive
  workspace="$(make_workspace)"
  trap 'rm -rf -- "${workspace}"' EXIT
  repository="${workspace}/repository"
  yubikey_recipients="${workspace}/yubikey-recipients.txt"

  [[ -r "${SSH_DIR}/id_rsa" ]] || fail "Missing ${SSH_DIR}/id_rsa."
  [[ -r "${SSH_DIR}/authorized_keys" ]] || fail "Missing ${SSH_DIR}/authorized_keys."
  [[ -r "${AGENIX_PUBLIC_KEY}" ]] || fail "Missing ${AGENIX_PUBLIC_KEY}."
  [[ -r "${DEFAULT_PUBLIC_KEY}" ]] || fail "Missing ${DEFAULT_PUBLIC_KEY}."

  config_source="${SSH_DIR}/config_external"
  if [[ ! -r "${config_source}" && -n "${CONFIG_EXTERNAL_FALLBACK}" && -r "${CONFIG_EXTERNAL_FALLBACK}" ]]; then
    config_source="${CONFIG_EXTERNAL_FALLBACK}"
    warn "Using retained config_external source at ${CONFIG_EXTERNAL_FALLBACK}."
  fi
  [[ -r "${config_source}" ]] || fail "Missing ${SSH_DIR}/config_external."

  select_git_identity
  clone_repository "${repository}"
  collect_yubikey_recipients "${repository}" > "${yubikey_recipients}"
  sync_recipient_rules "${repository}" "${yubikey_recipients}"

  info "Encrypting local secrets; plaintext will not enter the Git repository"
  ssh_archive="${workspace}/${SSH_ARCHIVE_NAME}"
  create_ssh_archive "${ssh_archive}"
  validate_ssh_archive "${ssh_archive}"
  encrypt_file "${SSH_DIR}/id_rsa" "${repository}/id_rsa.age" "${yubikey_recipients}"
  encrypt_file "${SSH_DIR}/authorized_keys" "${repository}/authorized_keys.age" "${yubikey_recipients}"
  encrypt_file "${config_source}" "${repository}/config_external.age" "${yubikey_recipients}"
  encrypt_file "${ssh_archive}" "${repository}/${SSH_ARCHIVE_CIPHERTEXT}" "${yubikey_recipients}"

  repository_git -C "${repository}" status --short
  if repository_git -C "${repository}" diff --quiet -- . && \
     repository_git -C "${repository}" diff --cached --quiet -- . && \
     [[ -z "$(repository_git -C "${repository}" ls-files --others --exclude-standard)" ]]; then
    info "The encrypted secrets repository is already current"
    return 0
  fi

  confirm "Commit and push these encrypted secret files to ${SECRETS_REMOTE}?" || \
    fail "Secrets push cancelled."

  ensure_gpg_agent_compatible
  repository_git -C "${repository}" add -- \
    secrets.nix id_rsa.age authorized_keys.age config_external.age "${SSH_ARCHIVE_CIPHERTEXT}"
  repository_git -C "${repository}" commit -m "chore: update encrypted workstation secrets" || \
    fail "Could not create the signed commit. Complete any GPG PIN or security-key touch prompt, then retry."
  repository_git -C "${repository}" push origin "${SECRETS_BRANCH}"
  info "Encrypted secrets pushed successfully"
)

decrypt_file() {
  local source="$1" destination="$2"
  run_age --decrypt "${age_identity_args[@]}" --output "${destination}" "${source}"
}

connected_yubikey_identities() {
  local destination="$1" plugin_output plugin_error

  install -m 600 /dev/null "${destination}"
  [[ -r "${YUBIKEY_IDENTITY_FILE}" ]] || return 0
  if ! command -v age-plugin-yubikey >/dev/null 2>&1; then
    warn "age-plugin-yubikey is unavailable; hardware Age identities cannot be inspected."
    return 1
  fi

  plugin_output="${destination}.plugin-output"
  plugin_error="${destination}.plugin-error"
  release_gpg_smartcard_for_age
  if ! run_age_plugin --identity > "${plugin_output}" 2> "${plugin_error}"; then
    warn "Could not inspect Age identities on the connected YubiKey."
    if [[ -s "${plugin_error}" ]]; then
      while IFS= read -r line; do
        printf '  %s\n' "${line}" >&2
      done < "${plugin_error}"
    fi
    return 1
  fi

  # The persistent locator file can contain several serial numbers. Passing
  # it directly to Age makes the plugin request the first absent card before
  # it considers the card that is actually connected. Keep only locators that
  # are both enrolled locally and reported by currently attached hardware.
  awk '
    NR == FNR {
      if ($0 ~ /^AGE-PLUGIN-YUBIKEY-[A-Z0-9]+$/) saved[$0] = 1
      next
    }
    $0 ~ /^AGE-PLUGIN-YUBIKEY-[A-Z0-9]+$/ && saved[$0] && !seen[$0]++ {
      print
    }
  ' "${YUBIKEY_IDENTITY_FILE}" "${plugin_output}" > "${destination}"
  chmod 600 "${destination}"
}

configure_age_identities() {
  local workspace="$1" candidate connected_identities file_identity_count=0

  age_identity_args=()
  for candidate in \
    "${AGENIX_PRIVATE_KEY}" \
    "${SSH_DIR}/id_ed25519"; do
    [[ -r "${candidate}" ]] || continue
    age_identity_args+=(--identity "${candidate}")
    file_identity_count=$((file_identity_count + 1))
  done

  if [[ -r "${YUBIKEY_IDENTITY_FILE}" ]]; then
    connected_identities="${workspace}/connected-yubikey-identities.txt"
    if connected_yubikey_identities "${connected_identities}" && \
       [[ -s "${connected_identities}" ]]; then
      age_identity_args+=(--identity "${connected_identities}")
      info "Using only Age identities visible on the connected YubiKey"
    elif (( file_identity_count )); then
      warn "No enrolled hardware Age identity is visible; trying the file-backed recovery identities."
    else
      fail "No connected YubiKey matches the saved Age identity locators. Insert an enrolled card, run ./setup yubikey-agenix --status, and retry."
    fi
  fi

  [[ "${#age_identity_args[@]}" -gt 0 ]] || \
    fail "No Agenix or YubiKey decryption identity is installed. Run ./setup yubikey-agenix with an enrolled YubiKey, or install ${AGENIX_PRIVATE_KEY}."

}

pull_secrets() (
  local workspace repository decrypted restore_root backup_suffix name target
  local ssh_archive backup_archive archive_available=0
  workspace="$(make_workspace)"
  trap 'rm -rf -- "${workspace}"' EXIT
  repository="${workspace}/repository"
  decrypted="${workspace}/decrypted"
  backup_suffix="$(date +%Y%m%d%H%M%S).$$"

  select_git_identity
  clone_repository "${repository}"
  install -d -m 700 "${decrypted}"
  configure_age_identities "${workspace}"

  for name in id_rsa authorized_keys config_external; do
    [[ -r "${repository}/${name}.age" ]] || fail "The secrets repository is missing ${name}.age."
    decrypt_file "${repository}/${name}.age" "${decrypted}/${name}"
  done

  ssh_archive="${decrypted}/${SSH_ARCHIVE_NAME}"
  restore_root="${workspace}/ssh-restore"
  if [[ -r "${repository}/${SSH_ARCHIVE_CIPHERTEXT}" ]]; then
    decrypt_file "${repository}/${SSH_ARCHIVE_CIPHERTEXT}" "${ssh_archive}"
    prepare_ssh_restore "${ssh_archive}" "${restore_root}"
    archive_available=1
  else
    warn "The private repository has no ${SSH_ARCHIVE_CIPHERTEXT}; restoring the three legacy secrets only."
    warn "Run ./setup update-secrets on a fully configured machine to create the encrypted SSH directory archive."
  fi

  ssh-keygen -lf "${decrypted}/id_rsa" >/dev/null || fail "Decrypted id_rsa is not a valid SSH key."
  ssh-keygen -lf "${decrypted}/authorized_keys" >/dev/null || fail "Decrypted authorized_keys is not a valid SSH public-key file."
  [[ -s "${decrypted}/config_external" ]] || fail "Decrypted config_external is empty."

  confirm "Back up existing files and restore the decrypted SSH secrets into ${SSH_DIR}?" || \
    fail "Secrets installation cancelled."

  install -d -m 700 "${SSH_DIR}"
  if (( archive_available )); then
    install -d -m 700 "${SSH_BACKUP_DIR}"
    backup_archive="${SSH_BACKUP_DIR}/ssh-before-restore-${backup_suffix}.tar.gz"
    create_ssh_archive "${backup_archive}"
    info "Backed up the current durable SSH directory to ${backup_archive}"
    restore_ssh_archive "${restore_root}"
  fi

  for name in id_rsa authorized_keys config_external; do
    target="${SSH_DIR}/${name}"
    if (( ! archive_available )) && [[ -e "${target}" || -L "${target}" ]]; then
      cp -p -- "${target}" "${target}.bk.${backup_suffix}"
      info "Backed up ${target} to ${target}.bk.${backup_suffix}"
    fi
    install -m 600 "${decrypted}/${name}" "${target}"
  done

  ssh-keygen -y -f "${SSH_DIR}/id_rsa" > "${decrypted}/id_rsa.pub"
  install -m 644 "${decrypted}/id_rsa.pub" "${SSH_DIR}/id_rsa.pub"
  info "Secrets decrypted and installed successfully"
)

usage() {
  printf 'Usage: %s <push|pull>\n' "${BASH_SOURCE[0]}"
}

main() {
  require_command age
  require_command awk
  require_command cmp
  require_command dirname
  require_command find
  require_command git
  require_command grep
  require_command install
  require_command mktemp
  require_command ssh
  require_command ssh-keygen
  require_command tar

  case "${1:-}" in
    push) push_secrets ;;
    pull) pull_secrets ;;
    -h|--help) usage ;;
    *) usage >&2; fail "Expected push or pull action." ;;
  esac
}

if [[ "${DOTFILES_SECRETS_SYNC_LIBRARY_ONLY:-}" != "1" ]]; then
  main "$@"
fi
