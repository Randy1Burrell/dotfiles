#!/usr/bin/env bash

set -Eeuo pipefail

PROGRAM_NAME="$(basename "$0")"
PAM_ORIGIN="pam://dotfiles-yubikey-login"
PAM_AUTHFILE="/etc/u2f_mappings"
PAM_BEGIN="# BEGIN dotfiles yubikey-login"
PAM_END="# END dotfiles yubikey-login"
PAM_BACKUP_DIR="/var/backups/dotfiles-yubikey-login"
MACOS_PIV_CERTIFICATE_REPAIRED=no
MACOS_PIV_PUBLIC_KEY_HASH=""
MACOS_PIV_SERIAL=""

info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mwarning:\033[0m %s\n' "$*" >&2; }
fail() { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<EOF
Usage: ${PROGRAM_NAME} [--add-key|--status|--disable|--help]

Enable local computer login with a YubiKey PIN. Run --add-key (the default)
once for each YubiKey. Password login remains available as a recovery method.

  --add-key  Enrol or pair the connected YubiKey (default)
  --status   Show the current login configuration
  --disable  Remove the configuration created by this script
  --help     Show this help

macOS uses the YubiKey PIV authentication certificate. Linux uses the FIDO2
PIN through pam_u2f. Windows setup is completed in Microsoft's protected UI
and requires a Microsoft Entra joined or hybrid joined computer.
EOF
}

confirm() {
  local answer
  [[ -t 0 ]] || fail "An interactive terminal is required."
  IFS= read -r -p "$1 [y/N] " answer
  case "${answer}" in
    y|Y|yes|YES|Yes) return 0 ;;
    *) return 1 ;;
  esac
}

normal_user() {
  local candidate
  candidate="${SUDO_USER:-${USER:-}}"
  [[ -n "${candidate}" && "${candidate}" != "root" ]] || \
    fail "Run this as the account that should use the YubiKey, not as root."
  printf '%s\n' "${candidate}"
}

run_as_user() {
  local login_user="$1"
  shift
  if [[ "$(id -u)" -eq 0 ]]; then
    sudo -u "${login_user}" "$@"
  else
    "$@"
  fi
}

macos_detect_one_yubikey() {
  local serials count
  command -v ykman >/dev/null 2>&1 || \
    fail "ykman is required to validate the PIV login certificate before pairing."
  serials="$(ykman list --serials 2>/dev/null | awk '/^[0-9]+$/ { print }')"
  count="$(printf '%s\n' "${serials}" | awk 'NF { count++ } END { print count + 0 }')"
  case "${count}" in
    0) fail "No YubiKey was found. Insert exactly one card and retry." ;;
    1) printf '%s\n' "${serials}" | awk 'NF { print; exit }' ;;
    *) fail "More than one YubiKey is connected. Leave only the card being paired." ;;
  esac
}

macos_extract_certificate_public_key() {
  local certificate="$1" public_key="$2"
  openssl x509 -in "${certificate}" -pubkey -noout 2>/dev/null >"${public_key}" || \
    fail "Could not read the public key from $(basename "${certificate}")."
}

macos_public_keys_match() {
  local first="$1" second="$2" first_der="$3" second_der="$4"
  openssl pkey -pubin -in "${first}" -outform DER -out "${first_der}" 2>/dev/null || return 1
  openssl pkey -pubin -in "${second}" -outform DER -out "${second_der}" 2>/dev/null || return 1
  cmp -s "${first_der}" "${second_der}"
}

macos_raw_public_key_hash() {
  local public_key="$1" workspace="$2" public_der raw_public_key
  local bit_string_offset hash
  public_der="${workspace}/apple-public-key.der"
  raw_public_key="${workspace}/apple-raw-public-key.bin"

  openssl pkey -pubin -in "${public_key}" -outform DER -out "${public_der}" 2>/dev/null || \
    fail "Could not encode the slot 9a public key for macOS."
  bit_string_offset="$(
    openssl asn1parse -inform DER -in "${public_der}" 2>/dev/null |
      awk '/BIT STRING/ { sub(/:.*/, "", $1); print $1; exit }'
  )"
  [[ "${bit_string_offset}" =~ ^[0-9]+$ ]] || \
    fail "Could not locate the raw slot 9a public key for macOS."
  openssl asn1parse \
    -inform DER \
    -in "${public_der}" \
    -strparse "${bit_string_offset}" \
    -out "${raw_public_key}" \
    -noout 2>/dev/null || \
    fail "Could not extract the raw slot 9a public key for macOS."
  hash="$(openssl dgst -sha1 "${raw_public_key}" 2>/dev/null | awk '{ print toupper($NF) }')"
  [[ "${hash}" =~ ^[[:xdigit:]]{40}$ ]] || \
    fail "Could not calculate the macOS slot 9a public-key hash."
  printf '%s\n' "${hash}"
}

macos_record_piv_identity() {
  local serial="$1" public_key="$2" workspace="$3"
  MACOS_PIV_SERIAL="${serial}"
  MACOS_PIV_PUBLIC_KEY_HASH="$(macos_raw_public_key_hash "${public_key}" "${workspace}")"
}

macos_prepare_piv_certificate() {
  local login_user="$1" serial workspace certificate attestation slot_public
  local certificate_public state_directory backup subject key_info
  command -v openssl >/dev/null 2>&1 || fail "openssl is required to validate the PIV login certificate."
  serial="$(macos_detect_one_yubikey)"
  workspace="$(mktemp -d "${TMPDIR:-/tmp}/yubikey-login-piv.XXXXXX")"
  certificate="${workspace}/certificate.pem"
  attestation="${workspace}/attestation.pem"
  slot_public="${workspace}/slot-public.pem"
  certificate_public="${workspace}/certificate-public.pem"

  ykman --device "${serial}" piv certificates export 9a "${certificate}" >/dev/null 2>&1 || {
    rm -rf -- "${workspace}"
    fail "PIV slot 9a has no certificate. Run ./setup yubikey-setup to create its login key and certificate."
  }
  macos_extract_certificate_public_key "${certificate}" "${certificate_public}"
  key_info="$(ykman --device "${serial}" piv keys info 9a 2>/dev/null || true)"
  if printf '%s\n' "${key_info}" | grep -Eiq 'Touch policy:[[:space:]]*(always|cached)'; then
    warn "PIV slot 9a requires touch. Touch the YubiKey after entering its PIN during pairing and login."
  fi

  if ykman --device "${serial}" piv keys attest 9a "${attestation}" >/dev/null 2>&1; then
    macos_extract_certificate_public_key "${attestation}" "${slot_public}"
    if macos_public_keys_match \
      "${slot_public}" "${certificate_public}" \
      "${workspace}/slot-public.der" "${workspace}/certificate-public.der"; then
      macos_record_piv_identity "${serial}" "${certificate_public}" "${workspace}"
      rm -rf -- "${workspace}"
      return 0
    fi

    state_directory="${XDG_STATE_HOME:-${HOME}/.local/state}/dotfiles/yubikeys/${serial}"
    install -d -m 700 "${state_directory}"
    backup="${state_directory}/piv-9a-certificate-mismatched-$(date +%Y%m%d-%H%M%S).pem"
    install -m 600 "${certificate}" "${backup}"
    warn "PIV slot 9a's certificate does not match its private key."
    warn "The mismatched certificate was backed up to ${backup}."
    confirm "Replace only the mismatched certificate while preserving the private key?" || {
      rm -rf -- "${workspace}"
      fail "The mismatched certificate was preserved; pairing cannot continue."
    }

    subject="$(printf '%s' "${login_user} PIV ${serial}" | tr -cd '[:alnum:] ._-')"
    printf '%s\n' 'Enter the PIV PIN if requested and touch the YubiKey when it flashes.'
    ykman --device "${serial}" piv certificates generate \
      --subject "CN=${subject}" \
      --valid-days 3650 \
      9a "${slot_public}"
    ykman --device "${serial}" piv certificates export 9a "${certificate}" >/dev/null
    macos_extract_certificate_public_key "${certificate}" "${certificate_public}"
    macos_public_keys_match \
      "${slot_public}" "${certificate_public}" \
      "${workspace}/slot-public.der" "${workspace}/certificate-public.der" || \
      fail "The replacement slot 9a certificate still does not match its private key."
    macos_record_piv_identity "${serial}" "${certificate_public}" "${workspace}"
    MACOS_PIV_CERTIFICATE_REPAIRED=yes
    rm -rf -- "${workspace}"
    return 0
  fi

  printf '%s\n' 'This imported PIV key cannot be attested. Enter its PIV PIN and touch the YubiKey to verify the certificate.'
  if ! ykman --device "${serial}" piv keys export --verify 9a "${slot_public}"; then
    rm -rf -- "${workspace}"
    fail "The slot 9a certificate could not be verified against its private key. Restore the matching certificate or reset and reprovision PIV."
  fi

  macos_record_piv_identity "${serial}" "${certificate_public}" "${workspace}"
  rm -rf -- "${workspace}"
}

macos_identities() {
  sc_auth identities 2>/dev/null | awk '
    {
      for (i = 1; i <= NF; i++) {
        value = $i
        gsub(/[^[:xdigit:]]/, "", value)
        if (length(value) == 40 || length(value) == 64) print value
      }
    }
  ' | awk '!seen[$0]++'
}

macos_identity_is_available() {
  local expected_hash hash
  expected_hash="$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')"
  while IFS= read -r hash; do
    hash="$(printf '%s' "${hash}" | tr '[:lower:]' '[:upper:]')"
    [[ "${hash}" == "${expected_hash}" ]] && return 0
  done < <(macos_identities)
  return 1
}

macos_reload_identity() {
  local serial="$1" expected_hash="$2" detected_serial attempt
  warn "macOS is exposing a stale smart-card identity instead of the connected YubiKey's current slot 9a key."
  printf 'Expected public-key hash for YubiKey %s: %s\n' "${serial}" "${expected_hash}" >&2
  printf 'CryptoTokenKit currently reports:\n' >&2
  sc_auth identities >&2 || true
  printf '\nRemove YubiKey %s, then press Return.\n' "${serial}" >&2
  IFS= read -r
  if ykman list --serials 2>/dev/null | awk -v serial="${serial}" '$0 == serial { found=1 } END { exit !found }'; then
    fail "YubiKey ${serial} is still connected. Remove it completely and run this action again."
  fi

  printf 'Reinsert YubiKey %s, wait for macOS to detect it, then press Return.\n' "${serial}" >&2
  IFS= read -r
  detected_serial="$(macos_detect_one_yubikey)"
  [[ "${detected_serial}" == "${serial}" ]] || \
    fail "Expected YubiKey ${serial}, but YubiKey ${detected_serial} was inserted."

  for attempt in {1..15}; do
    security list-smartcards >/dev/null 2>&1 || true
    macos_identity_is_available "${expected_hash}" && return 0
    sleep 1
  done

  printf 'CryptoTokenKit still reports:\n' >&2
  sc_auth identities >&2 || true
  fail "macOS did not publish YubiKey ${serial}'s current slot 9a identity. Log out and back in, reinsert the card, then retry."
}

choose_macos_identity() {
  local expected_hash="$1" serial="$2"
  if ! macos_identity_is_available "${expected_hash}"; then
    macos_reload_identity "${serial}" "${expected_hash}"
  fi
  macos_identity_is_available "${expected_hash}" || \
    fail "The connected YubiKey's verified identity is unavailable."
  printf '%s\n' "${expected_hash}"
}

macos_status() {
  local login_user="$1"
  info "Smart-card pairings for ${login_user}"
  if ! sc_auth list -u "${login_user}"; then
    warn "No smart-card pairing is configured for ${login_user}."
  fi
  printf '\nPassword login remains enabled. FileVault pre-boot unlock still uses the account password.\n'
}

macos_add_key() {
  local login_user="$1" hash
  command -v sc_auth >/dev/null 2>&1 || fail "This macOS version does not provide sc_auth."
  macos_prepare_piv_certificate "${login_user}"
  if [[ "${MACOS_PIV_CERTIFICATE_REPAIRED}" == yes ]]; then
    info "The PIV certificate was repaired successfully without replacing its private key."
    warn "Remove and reinsert this YubiKey so macOS reloads it, then run ./setup yubikey-login again to pair it."
    return 0
  fi
  [[ -n "${MACOS_PIV_PUBLIC_KEY_HASH}" && -n "${MACOS_PIV_SERIAL}" ]] || \
    fail "The connected YubiKey's verified macOS identity could not be determined."
  hash="$(choose_macos_identity "${MACOS_PIV_PUBLIC_KEY_HASH}" "${MACOS_PIV_SERIAL}")"
  if sc_auth list -u "${login_user}" 2>/dev/null | grep -Fqi -- "${hash}"; then
    info "That YubiKey certificate is already paired with ${login_user}."
    return 0
  fi
  printf 'This pairs the selected PIV certificate with %s. Password login remains available.\n' "${login_user}"
  confirm "Continue?" || fail "Cancelled."
  printf '%s\n' 'Enter the PIV PIN when macOS requests it. If the YubiKey flashes, touch it before pairing completes.'
  sudo sc_auth pair -u "${login_user}" -h "${hash}"
  info "YubiKey login is paired for ${login_user}."
  warn "FileVault pre-boot unlock still requires the account password."
}

macos_disable() {
  local login_user="$1"
  confirm "Remove all smart-card pairings for ${login_user}?" || fail "Cancelled."
  sudo sc_auth unpair -u "${login_user}"
  info "Smart-card login pairings were removed. Password login was not changed."
}

linux_is_nixos() {
  [[ -e /etc/NIXOS ]] || grep -qi '^ID=nixos' /etc/os-release 2>/dev/null
}

linux_install_pam_u2f() {
  if command -v pamu2fcfg >/dev/null 2>&1; then
    PAMU2FCFG=(pamu2fcfg)
    return 0
  fi
  if linux_is_nixos && command -v nix >/dev/null 2>&1; then
    PAMU2FCFG=(nix shell nixpkgs#pam_u2f --command pamu2fcfg)
    return 0
  fi

  if command -v apt-get >/dev/null 2>&1; then
    info "Installing pam_u2f"
    sudo apt-get update
    sudo apt-get install -y libpam-u2f
  elif command -v dnf >/dev/null 2>&1; then
    info "Installing pam_u2f"
    sudo dnf install -y pam-u2f
  elif command -v pacman >/dev/null 2>&1; then
    info "Installing pam_u2f"
    sudo pacman -S --needed pam-u2f
  else
    fail "Install pam_u2f with this distribution's package manager, then run this command again."
  fi
  command -v pamu2fcfg >/dev/null 2>&1 || fail "pamu2fcfg was not found after installing pam_u2f."
  PAMU2FCFG=(pamu2fcfg)
}

linux_generate_mapping() {
  local login_user="$1" append_flag=""
  local -a command
  command=("${PAMU2FCFG[@]}" -u "${login_user}" -N -o "${PAM_ORIGIN}" -i "${PAM_ORIGIN}")
  if sudo test -r "${PAM_AUTHFILE}" && sudo awk -F: -v user="${login_user}" '$1 == user { found=1 } END { exit !found }' "${PAM_AUTHFILE}"; then
    append_flag="-n"
    command+=("${append_flag}")
  fi

  info "Touch the connected YubiKey and enter its FIDO2 PIN when prompted." >&2
  run_as_user "${login_user}" "${command[@]}"
}

linux_complete_mapping() {
  local login_user="$1" generated="$2" existing=""
  if [[ "${generated}" == "${login_user}:"* ]]; then
    printf '%s\n' "${generated}"
    return 0
  fi
  if sudo test -r "${PAM_AUTHFILE}"; then
    existing="$(sudo awk -F: -v user="${login_user}" '$1 == user { print; exit }' "${PAM_AUTHFILE}")"
  fi
  [[ -n "${existing}" ]] || return 1
  case "${generated}" in
    :*) printf '%s%s\n' "${existing}" "${generated}" ;;
    *) printf '%s:%s\n' "${existing}" "${generated}" ;;
  esac
}

linux_save_mapping() {
  local login_user="$1" generated="$2" old_file new_file
  old_file="$(mktemp)"
  new_file="$(mktemp)"
  trap 'rm -f "${old_file:-}" "${new_file:-}"' RETURN
  if sudo test -f "${PAM_AUTHFILE}"; then
    sudo cat "${PAM_AUTHFILE}" | tee "${old_file}" >/dev/null
  fi

  awk -F: -v user="${login_user}" '$1 != user' "${old_file}" >"${new_file}"
  printf '%s\n' "${generated}" >>"${new_file}"
  sudo install -d -m 0755 "$(dirname "${PAM_AUTHFILE}")"
  sudo install -m 0600 -o root -g root "${new_file}" "${PAM_AUTHFILE}"
  trap - RETURN
  rm -f "${old_file}" "${new_file}"
}

linux_pam_module_path() {
  local path
  path="$(find /lib /usr/lib -type f -name pam_u2f.so -print -quit 2>/dev/null || true)"
  [[ -n "${path}" ]] || return 1
  printf '%s\n' "${path}"
}

linux_insert_pam_block() {
  local service_file="$1" module_path="$2" temp backup base
  sudo grep -Fq -- "${PAM_BEGIN}" "${service_file}" 2>/dev/null && return 0
  sudo grep -Eq '^[[:space:]]*(auth[[:space:]]+.*(include|substack)|@include)[[:space:]]+(common-auth|password-auth|system-auth|system-login|system-local-login)' "${service_file}" || return 1

  temp="$(mktemp)"
  sudo awk -v begin="${PAM_BEGIN}" -v end="${PAM_END}" -v module="${module_path}" -v authfile="${PAM_AUTHFILE}" -v origin="${PAM_ORIGIN}" '
    !inserted && $0 ~ /^[[:space:]]*(auth[[:space:]]+.*(include|substack)|@include)[[:space:]]+(common-auth|password-auth|system-auth|system-login|system-local-login)/ {
      print begin
      print "auth sufficient " module " authfile=" authfile " origin=" origin " appid=" origin " cue pinverification=1 userverification=0"
      print end
      inserted=1
    }
    { print }
    END { if (!inserted) exit 2 }
  ' "${service_file}" | tee "${temp}" >/dev/null

  sudo install -d -m 0700 "${PAM_BACKUP_DIR}"
  base="$(basename "${service_file}")"
  backup="${PAM_BACKUP_DIR}/${base}.$(date +%Y%m%d%H%M%S).bak"
  sudo cp -p "${service_file}" "${backup}"
  sudo install -m 0644 -o root -g root "${temp}" "${service_file}"
  rm -f "${temp}"
  info "Enabled YubiKey PIN login for ${base} (backup: ${backup})."
}

linux_configure_pam() {
  local module_path service_file configured=0
  module_path="$(linux_pam_module_path)" || fail "pam_u2f.so was not found. Install pam_u2f and retry."
  for service_file in \
    /etc/pam.d/gdm-password \
    /etc/pam.d/lightdm \
    /etc/pam.d/sddm \
    /etc/pam.d/plasmalogin \
    /etc/pam.d/login; do
    [[ -f "${service_file}" ]] || continue
    if linux_insert_pam_block "${service_file}" "${module_path}"; then
      configured=$((configured + 1))
    else
      warn "Skipped ${service_file}: no safe authentication include point was found."
    fi
  done
  [[ "${configured}" -gt 0 ]] || fail "The key mapping was saved, but no supported PAM login service could be configured safely. Password login was not changed."
}

linux_status() {
  local login_user="$1" key_count=0 service_file managed=0
  if sudo test -r "${PAM_AUTHFILE}"; then
    key_count="$(sudo awk -F: -v user="${login_user}" '$1 == user { print NF - 1; exit }' "${PAM_AUTHFILE}")"
    key_count="${key_count:-0}"
  fi
  printf 'YubiKeys enrolled for %s: %s\n' "${login_user}" "${key_count}"
  for service_file in /etc/pam.d/*; do
    [[ -f "${service_file}" ]] || continue
    if sudo grep -Fq -- "${PAM_BEGIN}" "${service_file}" 2>/dev/null; then
      printf 'Managed PAM service: %s\n' "${service_file}"
      managed=$((managed + 1))
    fi
  done
  if linux_is_nixos; then
    printf 'NixOS PAM services are configured declaratively by this repository.\n'
  elif [[ "${managed}" -eq 0 ]]; then
    printf 'Managed PAM services: none\n'
  fi
  printf 'Password login remains enabled as the fallback.\n'
}

linux_remove_pam_blocks() {
  local service_file temp
  for service_file in /etc/pam.d/*; do
    [[ -f "${service_file}" ]] || continue
    sudo grep -Fq -- "${PAM_BEGIN}" "${service_file}" 2>/dev/null || continue
    temp="$(mktemp)"
    sudo awk -v begin="${PAM_BEGIN}" -v end="${PAM_END}" '
      $0 == begin { skipping=1; next }
      $0 == end { skipping=0; next }
      !skipping { print }
    ' "${service_file}" | tee "${temp}" >/dev/null
    sudo install -m 0644 -o root -g root "${temp}" "${service_file}"
    rm -f "${temp}"
    info "Disabled YubiKey PIN login for $(basename "${service_file}")."
  done
}

linux_remove_user_mapping() {
  local login_user="$1" temp
  sudo test -f "${PAM_AUTHFILE}" || return 0
  temp="$(mktemp)"
  sudo awk -F: -v user="${login_user}" '$1 != user' "${PAM_AUTHFILE}" | tee "${temp}" >/dev/null
  sudo install -m 0600 -o root -g root "${temp}" "${PAM_AUTHFILE}"
  rm -f "${temp}"
}

linux_add_key() {
  local login_user="$1" generated complete_mapping
  linux_install_pam_u2f
  "${PAMU2FCFG[@]}" --help 2>&1 | grep -q -- '--pin-verification' || \
    fail "This pamu2fcfg is too old to require a FIDO2 PIN. Upgrade pam_u2f and retry."
  generated="$(linux_generate_mapping "${login_user}")"
  complete_mapping="$(linux_complete_mapping "${login_user}" "${generated}")" || \
    fail "pamu2fcfg returned an invalid mapping; no login files were changed."
  [[ "${complete_mapping}" == "${login_user}:"* ]] || fail "pamu2fcfg returned an invalid mapping; no login files were changed."
  linux_save_mapping "${login_user}" "${complete_mapping}"

  if linux_is_nixos; then
    info "The key mapping is saved. Run ./setup switch to activate the repository's NixOS PAM configuration."
  else
    linux_configure_pam
  fi
  info "YubiKey PIN login is enabled for ${login_user}. Run this command again for each additional key."
  warn "GNOME Keyring or KDE Wallet may still request the account password after a passwordless login."
}

linux_disable() {
  local login_user="$1"
  confirm "Remove this script's YubiKey login configuration for ${login_user}?" || fail "Cancelled."
  if ! linux_is_nixos; then
    linux_remove_pam_blocks
  fi
  linux_remove_user_mapping "${login_user}"
  info "YubiKey login enrollment was removed. Password login was not changed."
}

windows_script_path() {
  local directory path
  directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
  path="${directory}/yubikey-login-windows.ps1"
  if command -v cygpath >/dev/null 2>&1; then
    cygpath -w "${path}"
  elif command -v wslpath >/dev/null 2>&1; then
    wslpath -w "${path}"
  else
    printf '%s\n' "${path}"
  fi
}

run_windows_helper() {
  local action="$1" ps_action="Enable" shell_path script_path
  case "${action}" in
    status) ps_action="Status" ;;
    disable) ps_action="Disable" ;;
  esac
  script_path="$(windows_script_path)"
  if command -v powershell.exe >/dev/null 2>&1; then
    shell_path="powershell.exe"
  elif command -v pwsh.exe >/dev/null 2>&1; then
    shell_path="pwsh.exe"
  else
    fail "Windows PowerShell was not found. Run yubikey-login-windows.ps1 directly in PowerShell."
  fi
  "${shell_path}" -NoProfile -ExecutionPolicy Bypass -File "${script_path}" -Action "${ps_action}"
}

action="add-key"
case "${1:-}" in
  ""|--add-key) action="add-key" ;;
  --status) action="status" ;;
  --disable) action="disable" ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; fail "Unknown option: $1" ;;
esac
[[ $# -le 1 ]] || fail "Only one action may be supplied."

kernel="$(uname -s)"
case "${kernel}" in
  Darwin)
    login_user="$(normal_user)"
    case "${action}" in
      add-key) macos_add_key "${login_user}" ;;
      status) macos_status "${login_user}" ;;
      disable) macos_disable "${login_user}" ;;
    esac
    ;;
  Linux)
    if grep -qiE '(microsoft|wsl)' /proc/sys/kernel/osrelease /proc/version 2>/dev/null; then
      run_windows_helper "${action}"
    else
      login_user="$(normal_user)"
      case "${action}" in
        add-key) linux_add_key "${login_user}" ;;
        status) linux_status "${login_user}" ;;
        disable) linux_disable "${login_user}" ;;
      esac
    fi
    ;;
  MINGW*|MSYS*|CYGWIN*) run_windows_helper "${action}" ;;
  *) fail "Unsupported operating system: ${kernel}" ;;
esac
